{
  "ConnectionStrings": {
    // MySQL connection string - configure for your environment
    "DefaultConnection": "Server=localhost;Port=3306;Database=Revival;User=root;Password=your_password_here;"
  },
  
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  // RCCService configuration
  "RCCService": {
    // Base URL of the RCCService
    "Url": "http://localhost:3000",
    // API Key for RCCService authentication (if required)
    "ApiKey": "",
    // Timeout for RCCService requests in seconds
    "Timeout": 30
  },

  // Authentication settings
  "Authentication": {
    // Session expiration in hours
    "SessionExpirationHours": 24,
    // Enable secure cookies (HTTPS only)
    "SecureCookies": false
  },

  // Asset delivery settings
  "Assets": {
    // Base path for stored assets
    "BasePath": "wwwroot/assets",
    // Maximum asset file size in bytes (100 MB)
    "MaxFileSize": 104857600,
    // Allowed asset file extensions
    "AllowedExtensions": [ ".png", ".jpg", ".jpeg", ".gif", ".webp", ".ogg", ".mp3", ".wav", ".rbxl", ".rbxlx", ".obj", ".mtl" ]
  },

  // Game server settings
  "GameServer": {
    // Default maximum players per server
    "DefaultMaxPlayers": 50,
    // Server expiration time in minutes
    "ExpirationMinutes": 120,
    // Minimum time between server cleanup checks
    "CleanupIntervalMinutes": 5
  }
}