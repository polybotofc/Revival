{
  /*
   * Roblox Revival - Configuration File
   * ASP.NET Core 8 MVC with MySQL and Entity Framework Core
   * 
   * Target Roblox Client: Version 0.338.0.202976 (May 2018)
   */

  "ConnectionStrings": {
    /*
     * MySQL Database Connection
     * Configure with your MySQL server settings
     */
    "DefaultConnection": "Server=localhost;Port=3306;Database=Revival;User=root;Password=your_password_here;CharSet=utf8mb4;SslMode=None;"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "AllowedHosts": "*",

  /*
   * RCCService Configuration
   * Remote Lua Scripting Service for Game Server Management
   */
  "RCCService": {
    "Enabled": true,
    "BaseUrl": "http://localhost:3000",
    "ApiKey": "",
    "TimeoutSeconds": 30,
    "MaxRetries": 3,
    "RetryDelayMs": 1000
  },

  /*
   * Authentication Settings
   */
  "Authentication": {
    "CookieName": "RevivalAuth",
    "SessionExpirationHours": 24,
    "TicketExpirationHours": 2,
    "SecureCookies": false,
    "HttpOnly": true,
    "SameSiteMode": "Lax",
    "RequireAuthenticatedUser": true,
    "AllowAnonymousAccess": false
  },

  /*
   * Asset Delivery Service Configuration
   */
  "AssetDelivery": {
    "BasePath": "wwwroot/assets",
    "ThumbsPath": "wwwroot/thumbs",
    "MaxFileSizeBytes": 104857600,
    "AllowedExtensions": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".ogg", ".mp3", ".wav", ".rbxl", ".rbxlx", ".obj", ".mtl"],
    "CacheDurationMinutes": 60,
    "UseCdn": false,
    "CdnUrl": ""
  },

  /*
   * Game Server Configuration
   */
  "GameServer": {
    "DefaultMaxPlayers": 50,
    "MinPlayers": 1,
    "ServerExpirationMinutes": 120,
    "CleanupIntervalMinutes": 5,
    "AutoScaleEnabled": false,
    "MaxServersPerPlace": 10,
    "DefaultPort": 53640,
    "PingIntervalSeconds": 30
  },

  /*
   * Application Settings
   */
  "AppSettings": {
    "ApplicationName": "Roblox Revival",
    "ApplicationVersion": "1.0.0",
    "RobloxClientVersion": "0.338.0.202976",
    "BaseUrl": "http://localhost:5000",
    "Environment": "Development",
    "EnableSwagger": true,
    "EnableDeveloperExceptionPage": true,
    "EnableClientErrors": true
  },

  /*
   * Rate Limiting Configuration
   */
  "RateLimiting": {
    "EnableRateLimiting": true,
    "RequestsPerMinute": 60,
    "GameJoinRequestsPerMinute": 10,
    "AssetRequestsPerMinute": 120
  },

  /*
   * Security Settings
   */
  "Security": {
    "EnableHttps": false,
    "EnableCsp": true,
    "AllowedHosts": "*",
    "AllowedOrigins": "",
    "PasswordMinLength": 6,
    "PasswordRequireDigit": false,
    "PasswordRequireUppercase": false,
    "PasswordRequireLowercase": false,
    "PasswordRequireSpecialChar": false,
    "MaxLoginAttempts": 5,
    "LockoutDurationMinutes": 15
  }
}