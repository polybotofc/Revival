# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DATABASE_URL="file:./dev.db"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# RCC (Roblox Cloud Console) Configuration
RCC_HOST=localhost
RCC_PORT=64989
RCC_URL=http://localhost:64989

# Default Body Colors (Roblox Classic)
DEFAULT_BODY_COLOR_HEAD=194
DEFAULT_BODY_COLOR_TORSO=194
DEFAULT_BODY_COLOR_LEFT_ARM=194
DEFAULT_BODY_COLOR_RIGHT_ARM=194
DEFAULT_BODY_COLOR_LEFT_LEG=194
DEFAULT_BODY_COLOR_RIGHT_LEG=194

# Thumbnail Configuration
THUMBNAIL_SIZE=420
THUMBNAIL_CAMERA_TYPE=Portrait
